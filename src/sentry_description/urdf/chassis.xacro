<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
 <xacro:macro name="box_inertia" params="m x y z"><inertia
  ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/></xacro:macro>
 <xacro:macro name="sentry_chassis">
  <link name="base_link">
   <inertial><origin xyz="0 0 0.055"/><mass value="35.0"/><xacro:box_inertia m="35.0" x="0.56" y="0.56" z="0.20"/></inertial>
   <visual><origin rpy="1.570796 0 -1.570796"/><geometry><mesh filename="package://sentry_description/meshes/visual/chassis.stl" scale="0.001 0.001 0.001"/></geometry></visual>
   <!-- The planar simulator has no rigid-body dynamics.  Omitting this coarse
        collision avoids the onboard GPU lidar returning the robot itself. -->
  </link>
  <link name="imu_link"/><joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.08"/></joint>
 </xacro:macro>
 <xacro:macro name="sentry_armor" params="name x y yaw">
  <link name="armor_${name}_link">
   <visual><geometry><box size="0.135 0.018 0.065"/></geometry><material name="armor_dark"><color rgba="0.12 0.12 0.14 1"/></material></visual>
   <collision name="armor_${name}_collision"><geometry><box size="0.145 0.025 0.075"/></geometry></collision>
  </link>
  <joint name="armor_${name}_joint" type="fixed"><parent link="base_link"/><child link="armor_${name}_link"/><origin xyz="${x} ${y} 0.075" rpy="0 0 ${yaw}"/></joint>
 </xacro:macro>
</robot>
